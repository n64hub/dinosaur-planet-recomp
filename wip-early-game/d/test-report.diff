+void dino::story_watch_bits(const char* list) {
+    watch_all_bits = strcmp(list, "all") == 0;
+    for (const char* p = list; !watch_all_bits && p != nullptr; p = strchr(p, ',') ? strchr(p, ',') + 1 : nullptr) {
