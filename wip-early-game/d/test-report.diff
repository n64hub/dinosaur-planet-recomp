+
+# --watch-bits (src/game/story.cpp, development): func_80014670 sets the bit in $a0 to the value in $a1, and at its start
+# says so when the bit is watched.
+[[patches.hook]]
+func = "func_80014670"
+before_vram = 0x80014670
