+
+// DEBUG autopilot, not for commit. DINO_WALK names a file of steps: at <s>, w x z [r], b <hex> <s>, s x y <s>, p <s>.
+extern int dbg_cam_yaw; static double dbg_stuck = getenv("DINO_STUCK") ? atof(getenv("DINO_STUCK")) : 4.0;
+struct DbgStep { char k; float a, b, c; unsigned btn; };
+static std::vector<DbgStep> dbg_steps; static size_t dbg_i = 0; static double dbg_at = 0, dbg_t0 = -1, dbg_prog = 0; static float dbg_px = 0, dbg_pz = 0;
+volatile int dbg_walk_on = 0; volatile float dbg_x = 0, dbg_y = 0; volatile unsigned dbg_btn = 0;
+extern "C" void dbg_walk(uint8_t* rdram, recomp_context* ctx, double now) {
+    static bool loaded = false;
+    if (!loaded) { loaded = true; const char* f = getenv("DINO_WALK"); if (f) { FILE* h = fopen(f, "r"); char l[128]; while (h && fgets(l, 128, h)) { DbgStep d{}; float a=0,b=0,c=0; unsigned u=0;
+        if (sscanf(l, "at %f", &a) == 1) dbg_at = a;
+        else if (sscanf(l, "w %f %f %f", &a, &b, &c) >= 2) { d.k='w'; d.a=a; d.b=b; d.c=c>0?c:25; dbg_steps.push_back(d); }
+        else if (sscanf(l, "b %x %f", &u, &a) == 2) { d.k='b'; d.btn=u; d.a=a; dbg_steps.push_back(d); }
+        else if (sscanf(l, "s %f %f %f", &a, &b, &c) == 3) { d.k='s'; d.a=a; d.b=b; d.c=c; dbg_steps.push_back(d); }
+        else if (sscanf(l, "x %f %f", &a, &b) == 2) { d.k='x'; d.a=a; d.b=b; dbg_steps.push_back(d); }
+        else if (sscanf(l, "t %f %f %f", &a, &b, &c) == 3) { d.k='t'; d.a=a; d.b=b; d.c=c; dbg_steps.push_back(d); }
+        else if (sscanf(l, "p %f", &a) == 1) { d.k='p'; d.a=a; dbg_steps.push_back(d); } }
+        if (h) fclose(h); } }
+    if (dbg_steps.empty() || now < dbg_at) return;
+    if (dbg_i >= dbg_steps.size()) { dbg_walk_on = 0; return; }
+    call(rdram, ctx, player_object); int32_t o = (int32_t)ctx->r2; if (!o) return;
+    dbg_walk_on = 1; DbgStep& d = dbg_steps[dbg_i];
+    uint32_t ux = MEM_W(0x18, (gpr)o), uz = MEM_W(0x20, (gpr)o), uy = MEM_W(0x1C, (gpr)o); float px, pz, py; memcpy(&px,&ux,4); memcpy(&pz,&uz,4); memcpy(&py,&uy,4);
+    if (dbg_t0 < 0) { dbg_t0 = now; dbg_prog = now; dbg_px = px; dbg_pz = pz; fprintf(stderr, "walk: step %d %c %.0f %.0f at %.1f s from %.0f %.0f %.0f\n", (int)dbg_i, d.k, d.a, d.b, now, px, py, pz); }
+    bool done = false; dbg_x = 0; dbg_y = 0; dbg_btn = 0;
+    if (d.k == 'w') {
+        float dx = d.a - px, dz = d.b - pz; float dist = sqrtf(dx*dx + dz*dz);
+        if (dist < d.c) done = true;
+        else {
+            float D = atan2f(dx, dz); float cam = (float)(0x8000 - dbg_cam_yaw) * 3.14159265f / 32768.0f; float F = cam + 3.14159265f; float rel = D - F;
+            dbg_x = -sinf(rel); dbg_y = cosf(rel);
+            if (fabsf(px-dbg_px) + fabsf(pz-dbg_pz) > 30) { dbg_prog = now; dbg_px = px; dbg_pz = pz; }
+            if (now - dbg_prog > dbg_stuck) { fprintf(stderr, "walk: STUCK at %.0f %.0f %.0f going to %.0f %.0f\n", px, py, pz, d.a, d.b); done = true; }
+        }
+    }
+    else if (d.k == 'b') { dbg_btn = d.btn; if (now - dbg_t0 > d.a) done = true; }
+    else if (d.k == 's') { dbg_x = d.a; dbg_y = d.b; if (now - dbg_t0 > d.c) done = true; }
+    else if (d.k == 'x') {
+        typedef std::pair<int,int> C; static std::map<C,int> cells; static std::vector<C> stack; static C goal; static bool have=false, back=false; static double gt=0; static int lastx=0;
+        float cs = d.a; C cur((int)floorf(px/cs+0.5f), (int)floorf(pz/cs+0.5f));
+        if (now - dbg_t0 > d.b) done = true;
+        if (!have) {
+            if (stack.empty()) { stack.push_back(cur); }
+            C top = stack.back();
+            if (!cells.count(top) || cells[top] != 1) { cells[top] = 1; fprintf(stderr, "cell %d %d %.0f\n", top.first, top.second, py); }
+            static const int dx4[4] = {-1,0,0,1}, dz4[4] = {0,-1,1,0};
+            bool found = false;
+            for (int i = 0; i < 4 && !found; i++) { C n(top.first+dx4[i], top.second+dz4[i]); if (!cells.count(n)) { goal = n; found = true; back = false; have = true; gt = now; dbg_prog = now; dbg_px = px; dbg_pz = pz; } }
+            if (!found) { stack.pop_back(); if (stack.empty()) { fprintf(stderr, "explore: done\n"); done = true; } else { goal = stack.back(); back = true; have = true; gt = now; dbg_prog = now; dbg_px = px; dbg_pz = pz; } }
+        }
+        if (have) {
+            float gx = goal.first*cs, gz = goal.second*cs, dx = gx-px, dz = gz-pz, dist = sqrtf(dx*dx+dz*dz);
+            if (dist < cs*0.3f) { have = false; if (!back) stack.push_back(goal); }
+            else {
+                float D = atan2f(dx, dz); float cam = (float)(0x8000 - dbg_cam_yaw) * 3.14159265f / 32768.0f; float F = cam + 3.14159265f; float rel = D - F;
+                dbg_x = -sinf(rel); dbg_y = cosf(rel);
+                if (fabsf(px-dbg_px) + fabsf(pz-dbg_pz) > 12) { dbg_prog = now; dbg_px = px; dbg_pz = pz; }
+                if (now - dbg_prog > 0.5 || now - gt > 3.0) {
+                    if (back) { fprintf(stderr, "explore: lost way back at %.0f %.0f %.0f\n", px, py, pz); stack.clear(); have = false; }
+                    else { cells[goal] = 2; fprintf(stderr, "wall %d %d %.0f\n", goal.first, goal.second, py); goal = stack.back(); back = true; gt = now; dbg_prog = now; }
+                }
+            }
+        }
+    }
+    else if (d.k == 't') { uint32_t w; memcpy(&w,&d.a,4); MEM_W(0x18,(gpr)o)=w; MEM_W(0xC,(gpr)o)=w; memcpy(&w,&d.b,4); MEM_W(0x1C,(gpr)o)=w; MEM_W(0x10,(gpr)o)=w; memcpy(&w,&d.c,4); MEM_W(0x20,(gpr)o)=w; MEM_W(0x14,(gpr)o)=w; done = true; }
+    else if (d.k == 'p') { if (now - dbg_t0 > d.a) done = true; }
+    if (done) { dbg_i++; dbg_t0 = -1; }
 }
